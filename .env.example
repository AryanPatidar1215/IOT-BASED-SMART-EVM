PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=smartEVM

# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: creates the first admin automatically when the admins collection is empty.
# Or run `npm run create-admin` instead and leave these blank.
ADMIN_USERNAME=Aryan
ADMIN_PASSWORD=1234567

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
